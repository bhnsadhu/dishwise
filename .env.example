# Copy to .env.local (or run `vercel env pull`). Never commit real values.
# Without these, Dishwise runs in guest-only mode.

# Neon Postgres (provisioned via the Vercel Marketplace Neon integration)
DATABASE_URL=            # pooled, used by the app
DATABASE_URL_UNPOOLED=   # direct, used by drizzle-kit migrations

# Neon Auth (managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET= # you set this: openssl rand -base64 32  (min 32 chars)
