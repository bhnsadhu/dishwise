# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills installed by tooling (kept local)
/.agents/
/.claude/skills/
skills-lock.json

# Tesseract language data cached by node OCR runs
*.traineddata

# playwright
/test-results/
/playwright-report/

# third-party menu photos for local OCR checks (licensed CC; not redistributed)
/tests/ocr/real/

# local design mockups
/output/
